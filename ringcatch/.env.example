# =============================================================================
# slice2_5.js — the multi-tenant engine (the one to run in production)
# Every business's config lives in Supabase now, not env vars. One deployed
# process serves every tenant; the dialed number tells it which tenant answered.
# =============================================================================

# ---- Twilio account (required — shared across all tenants) ----
# From your Twilio Console dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# ---- Supabase (required) ----
# Project URL + SERVICE ROLE key (server-side only — this bypasses RLS, never
# expose it to a browser). The wizard/dashboard app uses the publishable key instead.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Nicer summaries (optional) ----
# Calls are summarized into 3-4 owner-friendly lines by an LLM.
# Priority: LLM_BASE_URL (OpenAI-compatible)  >  ANTHROPIC_API_KEY  >  raw transcript.
#
# FREE local dev via OmniRoute (runs on http://localhost:20128):
#   LLM_BASE_URL=http://localhost:20128/v1
#   LLM_MODEL=big-pickle     # pin a known-good free model — "auto" is a coin-flip
#   LLM_API_KEY=local        # across the free pool (some return garbage)
# For production, point LLM_BASE_URL at any OpenAI-compatible provider (OpenAI, Groq, …)
# and set LLM_MODEL accordingly — a stronger model = a more reliable receptionist.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Fallback path — used only if LLM_BASE_URL is empty. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Booking (optional, per calendar.js) ----
BUSINESS_TZ=America/New_York
BOOKING_LINK=
GOOGLE_CALENDAR_ID=
GOOGLE_ACCESS_TOKEN=

# ---- Deployment (set once deployed) ----
# Your public base URL, e.g. https://ringcatch.onrender.com — used to derive the
# wss:// ConversationRelay URL. Leave blank for local ngrok testing.
PUBLIC_URL=
RELAY_WSS_URL=
TTS_VOICE=en-US-Neural2-D

# Port (Render/Railway set this automatically; 3000 locally)
PORT=3000

# =============================================================================
# server.js / slice2.js — legacy single-tenant slices (kept for reference,
# not deployed). These read a single hardcoded business from env vars below.
# =============================================================================
TWILIO_NUMBER=+17705550184
OWNER_PHONE=+14045551234
BUSINESS_NAME=Rooter Bros Plumbing
BUSINESS_TRADE=plumbing
BUSINESS_HOURS=Mon–Sat, 7am to 6pm
BUSINESS_SERVICES=leak repair, water heaters, drain cleaning, toilets, faucets, and emergency calls
BUSINESS_AREA=the greater Marietta and Atlanta area
VALIDATE_TWILIO=false
